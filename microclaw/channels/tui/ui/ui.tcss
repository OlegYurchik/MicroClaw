ChatWidget {
    height: 1fr;
    layout: vertical;
}

#messages_container {
    height: 1fr;
    overflow-y: auto;
    display: none;
}

#queued_container {
    height: auto;
    overflow-y: auto;
    max-height: 30%;
    display: none;
}

#bottom_container {
    height: 100%;
    align: center middle;
}

#input_container {
    width: 75%;
    height: auto;
}

#user_input {
    width: 100%;
    min-height: 3;
    max-height: 6;
    height: auto;
}

MessageBox {
    height: auto;
    margin: 0 2;
    padding: 1 1;
    background: transparent;
}

MessageBox.user {
    outline-left: solid cyan;
    background: #2a2a2a;
}

#message_panel {
    height: auto;
    min-height: 0;
    display: none;
}

.action_message_box {
    margin: 0 2;
    padding: 1 1;
    height: auto;
    min-height: 2;
    background: transparent;
}

.action_message_box.confirmed {
    background: #1a472a;
}

.action_message_box.declined {
    background: #4a1a1a;
}

#slash_suggest {
    display: none;
    overlay: screen;
    constrain: none;
    height: auto;
    max-height: 8;
    width: auto;
    min-width: 20;
    border: none;
    background: $surface;
    offset: 0 -100%;
}

#status_label {
    width: 1fr;
    text-align: center;
}

.action_message_box > #message_panel {
    display: block;
}

#action_buttons {
    height: 2;
    align: center middle;
    margin-left: 1;
    layout: horizontal;
}

#action_buttons Button {
    width: 1fr;
    height: 3;
    content-align: center middle;
}

StatusBar {
    height: 1;
}

ThinkingIndicator {
    width: auto;
    height: 1;
    padding-left: 1;
}

StatsWidget {
    width: 1fr;
    height: 1;
    text-align: right;
    text-style: italic;
    padding-left: 1;
    padding-right: 1;
    background: transparent;
}
